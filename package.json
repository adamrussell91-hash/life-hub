{
  "name": "life-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:auth": "node scripts/generate-auth-secrets.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "dev": "node scripts/prepare-web.mjs && node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "node --test tests/browser/home.spec.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs"
  },
  "devDependencies": {
    "js-yaml": "4.3.0",
    "playwright": "1.61.1"
  },
  "engines": {
    "node": ">=22"
  }
}
