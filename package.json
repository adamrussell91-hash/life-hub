{
  "name": "life-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:apps && node scripts/prepare-web.mjs",
    "build:apps": "npm run build:teaching && npm run build:knowledge && npm run build:tasks && npm run build:professional",
    "build:teaching": "node scripts/build-spa.mjs teaching",
    "build:knowledge": "node scripts/build-spa.mjs knowledge",
    "build:tasks": "node scripts/build-spa.mjs tasks",
    "build:professional": "node scripts/build-spa.mjs professional",
    "generate:auth": "node scripts/generate-auth-secrets.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "dev": "node scripts/prepare-web.mjs && node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/home.spec.mjs tests/browser/hub-count.spec.mjs tests/browser/chat.spec.mjs tests/browser/nutrition.spec.mjs tests/browser/central-node.spec.mjs tests/browser/mind.spec.mjs tests/browser/fitness.spec.mjs tests/browser/morphing-popover.spec.mjs tests/browser/home-widgets.spec.mjs tests/browser/view-on-map.spec.mjs tests/browser/card-swipe.spec.mjs tests/browser/shortcuts.spec.mjs tests/browser/hub-map.spec.mjs tests/browser/body-charts.spec.mjs tests/browser/teaching-calendar-hub.spec.mjs tests/browser/tasks-calendar-hub.spec.mjs tests/browser/professional-calendar-hub.spec.mjs tests/browser/calendar-filter.spec.mjs tests/browser/river-routing.spec.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "forecast:report": "node scripts/forecast-report.mjs",
    "import:mind": "node scripts/import-mind-notion.mjs",
    "chadwick-voice": "bash tools/voice-lab/launch.sh --no-open"
  },
  "dependencies": {
    "@annotorious/annotorious": "^3.8.10",
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@blocksuite/blocks": "0.19.5",
    "@blocksuite/icons": "2.1.75",
    "@blocksuite/presets": "0.19.5",
    "@blocksuite/store": "0.19.5",
    "@floating-ui/dom": "^1.8.0",
    "@netlify/blobs": "^9.1.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uppy/core": "^4.5.3",
    "heic-to": "^1.1.2",
    "js-yaml": "4.3.0",
    "jscanify": "^1.4.0",
    "maplibre-gl": "^5.24.0",
    "media-chrome": "^4.19.2",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^5.4.296",
    "photoswipe": "^5.4.4",
    "wavesurfer.js": "^7.12.11",
    "yjs": "13.6.18"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "22.17.0",
    "d3-force": "^3.0.0",
    "elkjs": "^0.11.1",
    "happy-dom": "^17.4.4",
    "katex": "^0.16.47",
    "playwright": "1.61.1",
    "ts-fsrs": "^5.4.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "3.2.4",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@blocksuite/icons": "2.1.75"
  }
}
