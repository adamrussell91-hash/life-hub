# Safe placeholders only. Set deployment values in Netlify, never in this file.
LIFE_HUB_PASSPHRASE_HASH=replace-in-netlify
SESSION_SECRET=replace-in-netlify
GITHUB_REPOSITORY=owner/private-repository
GITHUB_BRANCH=main
GITHUB_TOKEN=replace-in-netlify
GITHUB_TOKEN_EXPIRES=YYYY-MM-DD
ANTHROPIC_API_KEY=replace-in-netlify
# Day One Classic email-import address (never commit the real value).
DAYONE_EMAIL=replace-in-netlify
RESEND_API_KEY=replace-in-netlify
# Verified Resend from-address, e.g. Life Hub <diary@yourdomain.com>
RESEND_FROM=Life Hub <onboarding@resend.dev>
SITE_ORIGIN=https://your-username.github.io
# Published iCloud calendar URLs (webcal:// or https://). Server-only secrets on
# Netlify life-hub2 — never commit real values. Without these, calendars show
# "iCloud calendars not linked" and Family/Social/Work/Health chips stay at 0.
ICAL_FEED_WORK=replace-in-netlify
ICAL_FEED_SOCIAL=replace-in-netlify
ICAL_FEED_FAMILY=replace-in-netlify
ICAL_FEED_HEALTH=replace-in-netlify
# Garage & Home Mailroom: read-only Gmail (docs/garage-home.md). Mint the
# refresh token with scripts/gmail-refresh-token.mjs. Never commit real values.
GMAIL_CLIENT_ID=replace-in-netlify
GMAIL_CLIENT_SECRET=replace-in-netlify
GMAIL_REFRESH_TOKEN=replace-in-netlify

# Alchemy block assistant: explicit low-cost model, no automatic escalation.
ALCHEMY_PASSIVE_MODEL=claude-haiku-4-5-20251001
# Default assumes the documented live 10s function limit: 8s total work.
# Set 26000 only after verifying the deployed function actually supports 26s.
ALCHEMY_FUNCTION_LIMIT_MS=10000
# Uses existing ANTHROPIC_API_KEY, GITHUB_TOKEN and conditional Teaching Blobs.
# Limits are installation-wide: passive 6/hour and 24/day; manual 10/10min and 100/day.
