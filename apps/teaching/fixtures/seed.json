        {
          "id": "block_l004_002",
          "type": "block",
          "block_type": "rich_text",
          "variant": "medium",
          "visibility": "student_teacher",
          "content": {
            "html": "<p>Ono constructs his identity around two roles: the respected artist who served his nation, and the patriarch securing his daughters' futures. Examine how these roles conflict when his wartime associations threaten Noriko's marriage prospects.</p>"
          },
          "layout": {},
          "print": {},
          "settings": {},
          "created_at": "2026-01-10T09:00:00.000Z",
