          "id": "block_l006_002",
          "type": "block",
          "block_type": "rich_text",
          "variant": "medium",
          "visibility": "student_teacher",
          "content": {
            "html": "<p>Ono's propaganda posters function as physical traces of a past he would rather forget. Consider how Ishiguro uses art—both fine and commercial—to externalise memory and make guilt visible to others.</p>"
          },
          "layout": {},
          "print": {},
          "settings": {},
