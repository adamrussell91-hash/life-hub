            "title": "Anthem for Doomed Youth",
            "attribution": "Wilfred Owen",
            "text": {
              "kind": "verse",
              "stanzas": [
                {
                  "id": "stanza_a",
                  "lines": [
                    { "id": "line_a1", "text": "What passing-bells for these who die as cattle?" },
                    { "id": "line_a2", "text": "Only the monstrous anger of the guns." }
                  ]
                }
              ]
            },
