{
  "name": "travel-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/copy-spa-fallback.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
