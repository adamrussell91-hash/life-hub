    "maplibre-gl": "^5.6.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.17.0",
    "@types/topojson-client": "^3.1.5",
    "happy-dom": "^17.4.4",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "3.2.4"
  }
