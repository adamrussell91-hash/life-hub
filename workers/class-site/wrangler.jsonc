{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "class-site",
  "main": "src/index.js",
  "workers_dev": false,
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "class.adam-russell.com",
      "custom_domain": true
    }
  ]
}
